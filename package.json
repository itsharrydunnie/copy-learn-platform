{
  "name": "@pacepard/api",
  "private": true,
  "main": "server.ts",
  "type": "module",
  "version": "0.10.00",
  "scripts": {
    "clean": "rm -rf dist",
    "clean:js": "find src -name '*.js' -type f -delete",
    "prebuild": "pnpm clean",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch  src/queues/workers/runWorker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/src/queues/workers/runWorker.js",
    "build": "tsc --incremental --skipLibCheck && tsc-alias && ts-add-js-extension --dir=dist --include=dist && copyfiles -u 1 \"src/_data/**/*\" \"src/views/**/*\" dist/",
    "check-types": "tsc --noEmit",
    "staging": "NODE_ENV=staging node dist/server.js",
    "prod": "NODE_ENV=production node dist/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --maxWorkers=2",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=integration",
    "test:modules": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=modules",
    "test:module": "node scripts/test-module.js",
    "test:auth": "pnpm test:module auth",
    "test:user": "pnpm test:module user",
    "test:token": "pnpm test:module token",
    "test:permission": "pnpm test:module permission",
    "test:repository": "pnpm test:module repository",
    "test:workflow": "pnpm test:module workflow"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.952.0",
    "@aws-sdk/lib-storage": "^3.953.0",
    "@aws-sdk/s3-request-presigner": "^3.953.0",
    "@btffamily/pacitude": "^1.0.32",
    "@exortek/express-mongo-sanitize": "^1.1.1",
    "@types/bull": "^4.10.4",
    "@types/busboy": "^1.5.4",
    "@types/dotenv": "^8.2.3",
    "@types/pug": "^2.0.10",
    "app-root-path": "^3.1.0",
    "bull": "^4.16.5",
    "bullmq": "^5.66.5",
    "busboy": "^1.6.0",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mailersend": "^2.6.0",
    "mongoose": "^9.0.1",
    "node-cron": "^4.2.1",
    "node-device-detector": "^2.2.5",
    "nodemailer": "^7.0.11",
    "path": "^0.12.7",
    "paystack-sdk": "^3.6.1",
    "pug": "^3.0.3",
    "redis": "^5.10.0",
    "slugify": "^1.6.6",
    "xss-advanced": "^1.0.2",
    "zeptomail": "^7.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@jest/globals": "^29.7.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/helmet": "^4.0.0",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/mongoose": "^5.11.97",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^6.0.2",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.1",
    "supertest": "^7.0.0",
    "swagger-cli": "^4.0.4",
    "ts-add-js-extension": "^1.6.6",
    "ts-jest": "^29.1.2",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.21.0"
  }
}
